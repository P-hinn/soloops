node_modules/
dist/
.env
.env.local
data/
*.log
.DS_Store
apps/api/prisma/generated/
apps/web/dist/

# Swift build artifacts of the iPhone app
apps/ios/**/.build/

# Tauri build artifacts of the macOS app
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# Tauri generates the ACL permissions for the app commands on every build.
apps/desktop/src-tauri/permissions/autogenerated/

# The iOS project is generated from apps/ios/project.yml by XcodeGen.
apps/ios/*.xcodeproj
apps/ios/SoloopsKit/.build

# Playwright
test-results/
playwright-report/
blob-report/

# The Apple developer team id, substituted into the generated Xcode
# project. Local so the repository carries no account identifier.
apps/ios/.team

# Xcode's per-user state (scheme order, breakpoints). Opening the generated
# project writes this; it says nothing about the project itself.
**/xcuserdata/
