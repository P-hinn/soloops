{
  "semi": false,
  "singleQuote": true,
  "printWidth": 100,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    { "files": "*.prisma", "options": { "tabWidth": 2 } },
    { "files": "*.md", "options": { "printWidth": 80, "proseWrap": "preserve" } }
  ]
}
