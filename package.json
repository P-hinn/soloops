{
  "name": "soloops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "up": "docker compose up --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f api worker",
    "db:push": "npm -w @soloops/api run db:push",
    "db:studio": "npm -w @soloops/api run db:studio",
    "seed": "npm -w @soloops/api run seed",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "test": "npm -w @soloops/api run test",
    "e2e": "npm -w @soloops/web run e2e",
    "e2e:install": "npx playwright install --with-deps chromium firefox webkit",
    "e2e:init": "tsx packages/e2e/src/cli.ts init",
    "e2e:update": "tsx packages/e2e/src/cli.ts update"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript-eslint": "^8.68.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
