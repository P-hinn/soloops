{
  "name": "soloops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "up": "npm run nodes:build && docker compose up --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f api worker",
    "app": "npm -w @soloops/desktop run dev",
    "app:build": "npm -w @soloops/desktop run build",
    "nodes:build": "npm -w n8n-nodes-soloops run build",
    "nodes:dev": "npm -w n8n-nodes-soloops run dev",
    "ports": "bash scripts/ports.sh",
    "ports:kill": "bash scripts/ports.sh kill",
    "db:push": "npm -w @soloops/api run db:push",
    "db:studio": "npm -w @soloops/api run db:studio",
    "seed": "npm -w @soloops/api run seed",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "test": "npm -w @soloops/api run test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.68.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
