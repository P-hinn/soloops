{
  "name": "Vertrag signiert (Zoho Sign → SoloOps)",
  "nodes": [
    {
      "parameters": {
        "content": "## Signatur abgeschlossen\n\nDiesen Webhook in Zoho Sign registrieren:\nEinstellungen → Developer/Webhooks → neuer Webhook auf die Produktions-URL dieses Workflows, Event **RequestCompleted** (gern auch RequestRejected/RequestExpired – landen im unteren Zweig).\n\nDer ►-Node wird durch deine SoloOps-Nodes ersetzt:\n- Follow-up „Signatur ausstehend\" abschließen\n- Notiz: `[VERTRAG] <Name> – signiert <Datum>`\n- signiertes PDF ablegen (Binary `data` dieses Workflows)",
        "height": 320,
        "width": 420
      },
      "id": "sticky1",
      "name": "Anleitung",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-20, -180]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "zoho-sign-abgeschlossen-hxulz8ejt8ggfd3g",
        "options": {}
      },
      "id": "webhook1",
      "name": "Webhook: Zoho Sign Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 220]
    },
    {
      "parameters": {
        "jsCode": "// Zoho-Webhook-Payload normalisieren (Struktur je nach Zoho-Version leicht unterschiedlich)\nconst b = $input.first().json.body || $input.first().json;\nconst op = b.notification_type || b.operation_type || (b.notifications && b.notifications.operation_type) || '';\nconst reqObj = b.requests || (b.notifications && b.notifications.requests) || {};\nconst request_id = reqObj.request_id || b.request_id;\nconst request_name = reqObj.request_name || b.request_name || '';\nif (!request_id) throw new Error('Kein request_id im Webhook-Payload: ' + JSON.stringify(b).slice(0, 500));\nreturn [{ json: { op, request_id, request_name, raw: b } }];"
      },
      "id": "code1",
      "name": "Event normalisieren",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 220]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.op }}",
              "rightValue": "RequestCompleted",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if1",
      "name": "Abgeschlossen?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://accounts.zoho.eu/oauth/v2/token",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "zohoSignApi",
        "options": {}
      },
      "id": "token1",
      "name": "Zoho Access Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 120],
      "credentials": {
        "zohoSignApi": {
          "id": "WOsDVXG7G9WDfqn3",
          "name": "Zoho Sign"
        }
      }
    },
    {
      "parameters": {
        "url": "=https://sign.zoho.eu/api/v1/requests/{{ $('Event normalisieren').first().json.request_id }}/pdf",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Zoho-oauthtoken {{ $('Zoho Access Token').first().json.access_token }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "getpdf1",
      "name": "Signiertes PDF holen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 120]
    },
    {
      "parameters": {},
      "id": "noop2",
      "name": "Andere Events (Rejected/Expired) – optional behandeln",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [660, 340]
    },
    {
      "parameters": {
        "resource": "note",
        "operation": "getMany",
        "additionalFields": {
          "q": "={{ 'Zoho-ID: ' + $json.request_id }}",
          "limit": 5
        }
      },
      "type": "CUSTOM.soloops",
      "typeVersion": 1,
      "position": [500, 120],
      "id": "soloops-vertragsnotiz-finden",
      "name": "SoloOps: Vertragsnotiz finden",
      "credentials": {
        "soloopsApi": {
          "id": "lUK2wsDgumSh7D5P",
          "name": "soloops account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Aus der Versand-Notiz holen, was der Rückweg braucht.\nconst event = $('Event normalisieren').first().json;\nconst notes = $input.all().map(i => i.json).filter(n => n && n.id);\n\nif (!notes.length) {\n  throw new Error(\n    `Keine [VERTRAG]-Notiz zur Zoho-ID ${event.request_id} gefunden. ` +\n    'Entweder kam der Webhook zu einem Vertrag, der nicht aus SoloOps verschickt wurde, ' +\n    'oder die Notiz wurde gelöscht.'\n  );\n}\n\nconst note = notes[0];\nconst titel = (note.title.split(/\\s+[–—-]\\s+/)[0] || '').replace(/^\\[VERTRAG\\]\\s*/, '').trim();\nconst taskId = (/Aufgabe:\\s*(\\S+)/.exec(note.body || '') || [])[1] || null;\n\n// Dateiname: ein Pfad pro Kunde, der Dateiname trägt Datum und Request-ID,\n// damit zwei Verträge gleichen Namens sich nicht überschreiben.\nconst stamp = new Date().toISOString().slice(0, 10);\nconst safe = titel.replace(/[^\\w\\s-]/g, '').replace(/\\s+/g, '-').toLowerCase() || 'vertrag';\n// Flach, mit der Kunden-ID im Dateinamen: n8ns Write-Node legt fehlende\n// Verzeichnisse nicht an (öffnet die Datei direkt mit O_CREAT), ein Ordner\n// pro Kunde wäre beim ersten Vertrag jedes Kunden ein ENOENT.\nconst relPfad = `${note.clientId}-${stamp}-${safe}-${event.request_id}.pdf`;\n\nreturn [{ json: {\n  request_id: event.request_id,\n  titel,\n  clientId: note.clientId,\n  taskId,\n  notizId: note.id,\n  relPfad,\n  zielPfad: `/data/vertraege/signiert/${relPfad}`\n} }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 120],
      "id": "kontext-bauen",
      "name": "Kontext bauen"
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "={{ $('Kontext bauen').first().json.zielPfad }}",
        "options": {}
      },
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [1100, 120],
      "id": "pdf-ablegen",
      "name": "PDF ablegen"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $('Kontext bauen').first().json.taskId }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1300, 120],
      "id": "gibt-es-eine-aufgabe",
      "name": "Aufgabe vorhanden?"
    },
    {
      "parameters": {
        "resource": "task",
        "operation": "complete",
        "taskId": "={{ $('Kontext bauen').first().json.taskId }}"
      },
      "type": "CUSTOM.soloops",
      "typeVersion": 1,
      "position": [1500, 40],
      "id": "soloops-aufgabe-abhaken",
      "name": "SoloOps: Aufgabe abhaken",
      "credentials": {
        "soloopsApi": {
          "id": "lUK2wsDgumSh7D5P",
          "name": "soloops account"
        }
      }
    },
    {
      "parameters": {
        "resource": "note",
        "operation": "create",
        "title": "=[VERTRAG] {{ $('Kontext bauen').first().json.titel }} – signiert {{ $now.toFormat('dd.LL.yyyy') }} – Zoho-ID: {{ $('Kontext bauen').first().json.request_id }} – Datei: {{ $('Kontext bauen').first().json.relPfad }}",
        "body": "=Von beiden Seiten unterschrieben. Signiertes PDF liegt unter {{ $('Kontext bauen').first().json.relPfad }} und ist in SoloOps unter Verträge abrufbar.",
        "additionalFields": {
          "clientId": "={{ $('Kontext bauen').first().json.clientId }}"
        }
      },
      "type": "CUSTOM.soloops",
      "typeVersion": 1,
      "position": [1700, 120],
      "id": "soloops-notiz-signiert",
      "name": "SoloOps: Notiz signiert",
      "credentials": {
        "soloopsApi": {
          "id": "lUK2wsDgumSh7D5P",
          "name": "soloops account"
        }
      }
    }
