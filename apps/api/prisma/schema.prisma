generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth / Owner
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Clients & projects
// ---------------------------------------------------------------------------

model Client {
  id                 String   @id @default(cuid())
  name               String
  company            String?
  email              String?
  phone              String?
  street             String?
  zip                String?
  city               String?
  country            String   @default("Deutschland")
  vatId              String?
  currency           String   @default("EUR")
  hourlyRateCents    Int?
  paymentTermDays    Int      @default(14)
  lexofficeContactId String?
  notes              String?
  archived           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  projects    Project[]
  invoices    Invoice[]
  timeEntries TimeEntry[]
  events      CalendarEvent[]
  meetings    Meeting[]
  notes_      Note[]
  leads       Lead[]
  mails       MailMessage[]
}

enum ProjectStatus {
  LEAD
  ACTIVE
  PAUSED
  DONE
  ARCHIVED
}

enum RepoProvider {
  GITHUB
  GITLAB
}

model Project {
  id              String        @id @default(cuid())
  key             String        @unique // Kurzkürzel, z.B. "ACME-DWH"
  name            String
  description     String?
  status          ProjectStatus @default(ACTIVE)
  color           String        @default("#6366f1")
  clientId        String?
  hourlyRateCents Int?
  budgetCents     Int?
  startsOn        DateTime?
  dueOn           DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  client      Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]
  notes_      Note[]
  meetings    Meeting[]
  events      CalendarEvent[]
  monitors    Monitor[]
  repos       PipelineRepo[]
  invoices    Invoice[]
  actionItems ActionItem[]
  digests     AiDigest[]
  leads       Lead[]
  mails       MailMessage[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Calendar
// ---------------------------------------------------------------------------

enum EventKind {
  FOCUS
  MEETING
  ADMIN
  PERSONAL
  TRAVEL
}

model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime
  allDay      Boolean   @default(false)
  kind        EventKind @default(FOCUS)
  projectId   String?
  clientId    String?
  externalUid String    @unique @default(cuid()) // stable UID for the ICS feed and CalDAV
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Video conferencing
  videoUrl      String?
  videoProvider VideoProvider?

  // Sync metadata
  /// A series from a remote calendar: read, but never written back.
  recurring Boolean @default(false)
  readOnly  Boolean @default(false)

  // --- Series {PAD}
  /// The UID from the source. Connects an overridden single occurrence
  /// (RECURRENCE-ID) with its series.
  sourceUid    String?
  /// The raw RRULE. Occurrences are expanded on read rather than
  /// materialised as rows — one row per series instead of a thousand.
  rrule        String?
  /// The series' original time zone. Without it, a daylight saving change
  /// shifts every occurrence by an hour.
  timeZone     String?
  /// Excluded start times (EXDATE + overridden instances).
  exDates      DateTime[]
  /// Set when this event replaces a single instance of a series.
  recurrenceId DateTime?
  /// When we last pushed — prevents echo loops in the two-way sync.
  lastPushedAt DateTime?

  project Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client  Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  meeting Meeting?
  links   EventLink[]

  @@index([startsAt, endsAt])
  @@index([updatedAt])
}

// ---------------------------------------------------------------------------
// Calendar sync (Google Calendar, Apple/iCloud over CalDAV)
// ---------------------------------------------------------------------------

enum CalendarProvider {
  GOOGLE
  APPLE
}

enum SyncDirection {
  PULL // read only
  PUSH // write only
  BOTH
}

enum VideoProvider {
  JITSI
  GOOGLE_MEET
  CUSTOM
}

model CalendarAccount {
  id        String           @id @default(cuid())
  provider  CalendarProvider
  label     String
  /// The account identifier (Google mail address or Apple ID) — display only.
  accountId String
  direction SyncDirection    @default(BOTH)
  enabled   Boolean          @default(true)

  /// The target calendar for everything created in soloops. Without this
  /// flag a new meeting would land in every connected account at once.
  /// Exactly one account carries it.
  isDefault Boolean @default(false)

  /// May the sync delete in the remote calendar? No by default: a misclick
  /// in soloops should not remove events from every device.
  allowRemoteDelete Boolean @default(false)

  // --- Google OAuth (tokens encrypted at rest, see services/secretbox.ts)
  accessTokenEnc  String?
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?

  // --- CalDAV (Apple): password encrypted at rest
  caldavBaseUrl  String?
  caldavUsername String?
  caldavPassEnc  String?

  /// Google: calendarId. CalDAV: the href of the calendar collection.
  remoteCalendarId   String?
  remoteCalendarName String?

  /// The colour in the week and month views. Assigned from a palette when
  /// the account is connected, changeable per calendar afterwards.
  color String @default("#5c76ff")

  /// Google: syncToken. CalDAV: the WebDAV sync token.
  syncToken  String?
  /// The CalDAV fallback when a server has no sync-collection support.
  ctag       String?
  lastSyncAt DateTime?
  lastError  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  links EventLink[]

  @@unique([provider, accountId, remoteCalendarId])
}

/// Links a local event to its counterpart in a remote calendar.
model EventLink {
  id        String @id @default(cuid())
  accountId String
  eventId   String

  /// Google: event.id. CalDAV: the href of the .ics resource.
  remoteId        String
  /// CalDAV: ETag. Google: etag.
  remoteEtag      String?
  /// The state we last saw on the remote side.
  remoteUpdatedAt DateTime?
  /// The state we last wrote there.
  pushedUpdatedAt DateTime?

  account CalendarAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  event   CalendarEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([accountId, eventId])
  @@unique([accountId, remoteId])
}

/**
 * A tombstone for locally deleted events.
 * Without it the deletion would be invisible to the sync: the EventLink goes
 * with the event, and the remote calendar would keep the entry forever.
 */
model SyncTombstone {
  id         String   @id @default(cuid())
  accountId  String
  remoteId   String
  remoteEtag String?
  createdAt  DateTime @default(now())

  @@unique([accountId, remoteId])
}

// ---------------------------------------------------------------------------
// Meetings
// ---------------------------------------------------------------------------

enum MeetingStatus {
  PLANNED
  RUNNING
  DONE
}

model Meeting {
  id           String        @id @default(cuid())
  title        String
  status       MeetingStatus @default(PLANNED)
  startsAt     DateTime
  endsAt       DateTime?
  participants String[]      @default([])
  agenda       String? // Markdown
  minutes      String? // Markdown, written by hand
  summary      String? // AI generated
  decisions    Json? // string[]
  projectId    String?
  clientId     String?
  eventId      String?       @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Video conferencing — mirrored into the calendar entry on creation
  videoUrl      String?
  videoProvider VideoProvider?

  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client      Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  event       CalendarEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  actionItems ActionItem[]
  notes_      Note[]

  @@index([startsAt])
}

model ActionItem {
  id        String    @id @default(cuid())
  title     String
  done      Boolean   @default(false)
  dueOn     DateTime?
  assignee  String?
  source    String    @default("MANUAL") // MANUAL | AI | MCP
  meetingId String?
  projectId String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([done, dueOn])
}

// ---------------------------------------------------------------------------
// Notes
// ---------------------------------------------------------------------------

model Note {
  id        String   @id @default(cuid())
  title     String
  body      String   @default("") // Markdown
  tags      String[] @default([])
  pinned    Boolean  @default(false)
  projectId String?
  clientId  String?
  meetingId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([updatedAt])
}

// ---------------------------------------------------------------------------
// Uptime (a mirror of UptimeRobot)
// ---------------------------------------------------------------------------

model Monitor {
  id            String    @id @default(cuid())
  uptimeRobotId BigInt    @unique
  friendlyName  String
  url           String
  type          Int       @default(1)
  status        Int       @default(2) // 0 paused, 1 not checked, 2 up, 8 seems down, 9 down
  intervalSec   Int       @default(300)
  ratio24h      Float?
  ratio7d       Float?
  ratio30d      Float?
  avgResponseMs Int?
  projectId     String?
  lastCheckedAt DateTime?
  updatedAt     DateTime  @updatedAt

  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  incidents Incident[]
}

model Incident {
  id          String    @id @default(cuid())
  monitorId   String
  externalId  String
  startedAt   DateTime
  endedAt     DateTime?
  durationSec Int?
  reason      String?

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@unique([monitorId, externalId])
  @@index([startedAt])
}

// ---------------------------------------------------------------------------
// CI/CD
// ---------------------------------------------------------------------------

enum RunStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
  UNKNOWN
}

model PipelineRepo {
  id           String       @id @default(cuid())
  provider     RepoProvider
  slug         String // owner/repo or group/project
  branch       String       @default("main")
  projectId    String?
  enabled      Boolean      @default(true)
  lastSyncedAt DateTime?
  createdAt    DateTime     @default(now())

  project Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  runs    PipelineRun[]

  @@unique([provider, slug])
}

model PipelineRun {
  id            String    @id @default(cuid())
  repoId        String
  externalId    String
  name          String
  branch        String
  commitSha     String?
  commitMessage String?
  status        RunStatus @default(UNKNOWN)
  url           String?
  actor         String?
  startedAt     DateTime?
  finishedAt    DateTime?
  durationSec   Int?

  repo PipelineRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, externalId])
  @@index([startedAt])
}

// ---------------------------------------------------------------------------
// Time tracking
// ---------------------------------------------------------------------------

enum TimeSource {
  TIMER
  MANUAL
  MCP
}

model TimeEntry {
  id            String     @id @default(cuid())
  projectId     String
  clientId      String?
  description   String     @default("")
  startedAt     DateTime
  endedAt       DateTime?
  durationSec   Int        @default(0)
  billable      Boolean    @default(true)
  rateCents     Int?
  tags          String[]   @default([])
  source        TimeSource @default(TIMER)
  invoiceItemId String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  invoiceItem InvoiceItem? @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)

  @@index([startedAt])
  @@index([projectId, billable, invoiceItemId])
}

// ---------------------------------------------------------------------------
// Activity
// ---------------------------------------------------------------------------

/// One sample from the Mac: which app was in front, what its window was
/// called, how long nobody has typed. The desktop app writes them on a fixed
/// beat; the samples become segments and eventually suggested time entries.
///
/// The data stays on this machine. None of it goes to a third-party API —
/// mapping it to projects happens locally.
model ActivitySample {
  id String @id @default(cuid())

  /// The moment of the sample, unique: the desktop app buffers and resends
  /// when the API was unreachable. Without this constraint the same instant
  /// would appear twice after a retry.
  at DateTime @unique

  bundleId String @default("")
  appName  String @default("")
  title    String @default("")

  /// The window title was deliberately left out because the app is on the
  /// blocklist (password managers, banking, messengers). The time range stays
  /// visible, the content does not.
  redacted Boolean @default(false)

  /// Seconds since the last keyboard or mouse input. Tells work apart from
  /// an open window.
  idleSec Int @default(0)

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Invoices
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id                String        @id @default(cuid())
  number            String        @unique
  status            InvoiceStatus @default(DRAFT)
  clientId          String
  projectId         String?
  issueDate         DateTime      @default(now())
  dueDate           DateTime
  currency          String        @default("EUR")
  subtotalCents     Int           @default(0)
  taxRate           Float         @default(19)
  taxCents          Int           @default(0)
  totalCents        Int           @default(0)
  smallBusiness     Boolean       @default(false)
  intro             String?
  notes             String?
  pdfPath           String?
  paidAt            DateTime?
  lexofficeId       String?
  lexofficeSyncedAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  client  Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items   InvoiceItem[]

  @@index([status, dueDate])
}

model InvoiceItem {
  id             String  @id @default(cuid())
  invoiceId      String
  position       Int
  description    String
  quantity       Decimal @db.Decimal(10, 2)
  unit           String  @default("Std.")
  unitPriceCents Int
  amountCents    Int

  invoice     Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  @@index([invoiceId, position])
}

// ---------------------------------------------------------------------------
// AI digests & settings
// ---------------------------------------------------------------------------

model AiDigest {
  id        String   @id @default(cuid())
  projectId String?
  kind      String // project | week | meeting
  model     String
  headline  String   @default("")
  content   String
  data      Json?
  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([kind, createdAt])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Sales: leads, offers, history
// ---------------------------------------------------------------------------

enum LeadStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  REFERRAL
  WEBSITE
  OUTBOUND
  NETWORK
  EVENT
  OTHER
}

model Lead {
  id     String     @id @default(cuid())
  title  String
  stage  LeadStage  @default(NEW)
  source LeadSource @default(OTHER)

  // Contact. A lead often has no client record yet — it becomes one only
  // when the deal is won. Until then the data lives here.
  contactName  String?
  contactEmail String?
  company      String?
  phone        String?

  /// The expected deal value. Once an offer is out, the valuation prefers
  /// its amount — see services/leadValue.ts.
  valueCents Int?
  currency   String @default("EUR")

  /// Your own estimate in percent. Carries the weighted forecast.
  probability Int @default(0)

  expectedCloseOn DateTime?
  lostReason      String?
  notes           String?

  // --- AI scoring (never overwrites `probability`) -------------------------
  aiScore       Int?
  aiScoreReason String?
  aiNextStep    String?
  aiScoredAt    DateTime?

  /// The last activity of any kind — the basis for "gone quiet too long".
  lastActivityAt DateTime @default(now())

  clientId  String?
  projectId String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client     Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project    Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  offers     Offer[]
  activities LeadActivity[]
  mails      MailMessage[]

  @@index([stage, archived])
  @@index([lastActivityAt])
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

/// What was offered to whom for how much. Deliberately separate from
/// Invoice: an offer is not a claim and may be changed afterwards.
model Offer {
  id     String      @id @default(cuid())
  leadId String
  number String?     @unique
  title  String
  status OfferStatus @default(DRAFT)

  amountCents Int
  currency    String @default("EUR")
  taxRate     Float  @default(19)

  scope      String?
  sentOn     DateTime?
  validUntil DateTime?
  decidedOn  DateTime?
  notes      String?

  /// The invoice that came out of the accepted offer.
  invoiceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, status])
}

enum ActivityKind {
  NOTE
  CALL
  MAIL
  MEETING
  OFFER
  STAGE_CHANGE
}

model LeadActivity {
  id         String       @id @default(cuid())
  leadId     String
  kind       ActivityKind
  body       String
  occurredAt DateTime     @default(now())
  /// MANUAL | SYSTEM | AI — so that generated entries can be removed again
  /// without taking hand-written ones with them.
  source     String       @default("MANUAL")
  createdAt  DateTime     @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, occurredAt])
}

// ---------------------------------------------------------------------------
// Inbox (read-only)
// ---------------------------------------------------------------------------

model MailAccount {
  id    String @id @default(cuid())
  label String
  email String @unique

  imapHost    String
  imapPort    Int     @default(993)
  imapSecure  Boolean @default(true)
  imapUser    String
  /// Encrypted at rest, see services/secretbox.ts
  imapPassEnc String

  /// Which folders are read. More than INBOX is rarely necessary.
  folders String[] @default(["INBOX"])

  /// No archive import: older mail is not fetched. Set to "90 days ago"
  /// when the account is connected and never touched again.
  syncSince DateTime

  enabled    Boolean   @default(true)
  lastSyncAt DateTime?
  lastError  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  folderStates MailFolderState[]
  messages     MailMessage[]
}

/// IMAP counts up per folder. The UIDVALIDITY has to be carried along: when
/// the server changes it, every remembered UID is worthless and we start over.
model MailFolderState {
  id          String   @id @default(cuid())
  accountId   String
  folder      String
  uidValidity BigInt?
  lastUid     BigInt   @default(0)
  updatedAt   DateTime @updatedAt

  account MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, folder])
}

enum MailCategory {
  LEAD
  PROJECT
  INVOICE
  ADMIN
  OTHER
}

model MailMessage {
  id        String @id @default(cuid())
  accountId String

  /// The RFC 5322 Message-ID. Unique across folders — prevents duplicates
  /// when the same mail sits in INBOX and in a subfolder.
  messageId String @unique
  uid       BigInt
  folder    String

  fromName  String?
  fromEmail String
  toEmails  String[]
  subject   String
  sentAt    DateTime

  /// Headers and body. No attachments — the mailbox stays the source.
  bodyText String
  snippet  String

  category MailCategory @default(OTHER)

  /// The AI's suggestion where it takes the mail for a new enquiry: title,
  /// contact, company, summary and any amount named. A suggestion only — a
  /// lead comes out of it at the push of a button.
  leadSuggestion Json?

  /// RULE | AI | MANUAL — a manual assignment is never overwritten.
  assignedBy String  @default("RULE")
  confidence Float?
  aiReason   String?

  leadId    String?
  clientId  String?
  projectId String?

  /// Done: read and filed, disappears from the inbox.
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lead    Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  client  Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([category, handled])
  @@index([sentAt])
  @@index([fromEmail])
}
