    "@soloops/shared": "*",
    "bullmq": "^6.3.1",
    "fastify": "^5.12.1",
    "imapflow": "^2.1.0",
    "ioredis": "^6.0.0",
    "mailparser": "^3.9.29",
    "pdfkit": "^0.16.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.7",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
