<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Granted by Apple per app, on request:
	     https://developer.apple.com/contact/carplay/
	     Until it is in the provisioning profile, the CarPlay scene is never
	     created — not on a head unit and not in Xcode's CarPlay simulator.
	     Switching category means changing this key and nothing else; see
	     CarPlayConfiguration.

	     It ships commented out, because an entitlement that is not in the
	     profile does not merely disable the feature — it fails the signing
	     step, so the app cannot be installed on a phone at all. Uncomment
	     the two lines once the grant is through; nothing else changes.
	<key>com.apple.developer.carplay-audio</key>
	<true/>
	-->

	<!-- The store-and-forward route for when the Mac is not reachable. The
	     container holds op batches only, never the database itself.

	     Commented out because iCloud needs a paid membership — a free personal
	     team cannot sign it, and the error Xcode gives names the team rather
	     than the capability. Nothing else has to change for this: the transport
	     asks for the container and gets nil, and SyncCoordinator skips the
	     route. Pairing and syncing over the local network are untouched.
	     Uncomment all three keys once the membership is back.
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.soloops.app</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.com.soloops.app</string>
	</array>
	-->
</dict>
</plist>
