<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The five keys Xcode injects only when it *generates* an Info.plist.
	     This one is hand-written (see project.yml: generating it would
	     overwrite the scene manifest the CarPlay scene depends on), so they
	     have to be here. Without CFBundleIdentifier and CFBundleExecutable the
	     bundle does not install and does not launch; the App Intents training
	     step refuses to parse it at build time, which is where this shows up
	     first. The values are build settings, expanded on copy. -->
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>de</string>

	<key>CFBundleDisplayName</key>
	<string>soloops</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>

	<!-- The pairing QR code opens the app with the invitation in it, so that
	     scanning with the camera is the whole setup. -->
	<!-- Without this the app runs letterboxed in compatibility mode: not
	     full screen, everything scaled, and the keyboard squeezed to match.
	     An empty dict is the whole declaration — it says "this app is built
	     for the current screen", which is all iOS wants to know. -->
	<!-- The same typeface the web interface uses, so the two halves of
	     soloops do not look like two products. Static cuts rather than the
	     variable file: UIFont picks an instance by name, and three named
	     weights are less to go wrong than one axis. OFL, see Fonts/OFL.txt. -->
	<key>UIAppFonts</key>
	<array>
		<string>Fonts/SpaceGrotesk-Regular.ttf</string>
		<string>Fonts/SpaceGrotesk-Medium.ttf</string>
		<string>Fonts/SpaceGrotesk-Bold.ttf</string>
	</array>

	<key>UILaunchScreen</key>
	<dict/>

	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.soloops.app.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>soloops</string>
			</array>
		</dict>
	</array>

	<!-- Speech has to keep going with the screen off and the app in the
	     background, which is the normal state while driving. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- The LAN sync talks to a local IP over plain HTTP. The exception is
	     deliberately narrow: only local names, nothing on the internet. The
	     Mac serves the API without TLS and giving it a certificate for a
	     private address is not something a one-person setup should need. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Only ever to read the pairing code off the Mac's screen. Nothing in
	     the app takes a picture or keeps a frame. -->
	<key>NSCameraUsageDescription</key>
	<string>Zum Scannen des Kopplungscodes, den soloops auf dem Mac anzeigt.</string>

	<!-- Required since iOS 14 to speak to the Mac on the local network. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>soloops gleicht Termine und Leads direkt mit deinem Mac ab, ohne Server.</string>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<!-- The phone window. No delegate class: SwiftUI's `App` owns
			     this scene, and naming a class that does not exist here is a
			     crash on launch rather than an error at build time. The role
			     still has to be declared, because a manifest that lists only
			     the CarPlay role leaves the app with no window at all. -->
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
				</dict>
			</array>

			<!-- The CarPlay screen. The system creates this scene only when
			     the CarPlay entitlement is in the provisioning profile; see
			     CarPlaySceneDelegate for what that means in practice. -->
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>CarPlay Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
