{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "soloops",
  "version": "0.1.0",
  "identifier": "com.philippniestroj.soloops",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "soloops",
        "width": 1360,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#f1efe8",
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
