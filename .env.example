# ---------------------------------------------------------------------------
# soloops — copy to .env and fill in
# ---------------------------------------------------------------------------

# --- Basics ----------------------------------------------------------------
NODE_ENV=development
TZ=Europe/Berlin
APP_URL=http://localhost:5174
# Host port of the frontend in development (the container stays on 5173)
WEB_PORT=5174
# Host port of the API in development (the container stays on 3000)
API_PORT=3000
# Host port in production (docker-compose.prod.yml). Do not pick 3000 — on
# the server that is already taken by the portfolio.
SOLOOPS_PORT=8090

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=soloops
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=soloops
DATABASE_URL=postgresql://soloops:change-me-postgres@postgres:5432/soloops?schema=public

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Auth ------------------------------------------------------------------
# openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret-min-32-chars-long-please
# Static bearer token for the worker + MCP server (machine clients)
SERVICE_TOKEN=change-me-service-token

# The first user, created by the initial seed
OWNER_EMAIL=contact@philippniestroj.com
OWNER_NAME=Philipp Niestroj
OWNER_PASSWORD=change-me-login-password

# --- Anthropic (project digests, meeting summaries, action items) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- UptimeRobot -----------------------------------------------------------
# https://uptimerobot.com/dashboard -> Integrations & API -> Main API Key
UPTIMEROBOT_API_KEY=
UPTIME_POLL_CRON=*/5 * * * *

# --- CI/CD -----------------------------------------------------------------
# GitHub PAT with repo + workflow (read)
GITHUB_TOKEN=
# GitLab PAT with read_api
GITLAB_TOKEN=
GITLAB_HOST=https://gitlab.com
PIPELINE_POLL_CRON=*/3 * * * *

# --- Automations (n8n) -----------------------------------------------------
# n8n comes along as its own container and is served under /n8n/ through the
# web origin — that is what lets the editor sit in an iframe inside soloops.
# Pin the image once things work; `latest` can change the editor under you.
N8N_IMAGE_TAG=latest
# Host port for reaching n8n directly, bypassing the proxy.
N8N_PORT=5678
# How the API reaches n8n inside the compose network.
N8N_BASE_URL=http://n8n:5678
# How the browser reaches it. Must stay same-origin.
N8N_PUBLIC_PATH=/n8n/
# n8n -> Settings -> n8n API -> Create an API key. Without it soloops shows
# the editor but mirrors no flows and no runs. Can also be pasted in the
# interface under Automatisierungen, which wins over this line.
N8N_API_KEY=
AUTOMATION_POLL_CRON=*/2 * * * *
# Runs kept per flow for the monitoring. The full history stays in n8n.
AUTOMATION_RUN_HISTORY=50

# --- lexoffice -------------------------------------------------------------
# https://app.lexoffice.de/addons/public-api
LEXOFFICE_API_KEY=
LEXOFFICE_BASE_URL=https://api.lexoffice.io

# --- Calendar sync ---------------------------------------------------------
# Google Cloud Console -> enable the Calendar API -> Credentials ->
# OAuth client ID (web application) with exactly this redirect URI:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar-accounts/google/callback
# Apple: create an app-specific password at appleid.apple.com
CALDAV_APPLE_URL=https://caldav.icloud.com
CALENDAR_SYNC_CRON=*/10 * * * *

# --- Inbox (read-only) -----------------------------------------------------
# Per-account credentials go in the interface under Settings, not here.
MAIL_POLL_CRON=*/10 * * * *
MAIL_BACKFILL_DAYS=90
# A hard floor: older mail is never fetched, whatever the line above says.
MAIL_SYNC_FROM=2026-09-01
MAIL_MAX_PER_RUN=200

# --- Video conferencing ----------------------------------------------------
# JITSI (no account needed) | GOOGLE_MEET (needs a Google account) | CUSTOM
VIDEO_PROVIDER=JITSI
JITSI_BASE_URL=https://meet.jit.si
# Your own permanent room (Zoom/Teams), only for VIDEO_PROVIDER=CUSTOM
VIDEO_CUSTOM_URL=


# --- Activity (macOS app) --------------------------------------------------
# Samples of which app is in front and what its window is called. Read by the
# desktop app, not by the containers. On first run macOS asks for the
# Accessibility permission; without it nothing is recorded.
# The data stays local — none of it goes to a third-party API.
ACTIVITY_TRACKING=false
ACTIVITY_SAMPLE_SECONDS=20
# Past this much idle time it no longer counts as work.
ACTIVITY_IDLE_THRESHOLD_SEC=300
# Raw samples older than this are cleared out by the worker overnight.
ACTIVITY_RETENTION_DAYS=30
# Apps whose window titles are never stored (bundle id prefixes, comma
# separated). That they ran stays visible — what was in them does not.
ACTIVITY_PRIVATE_APPS=com.1password.,com.apple.keychainaccess,com.apple.Passwords,com.apple.MobileSMS,net.whatsapp.,org.whispersystems.signal,ch.threema.

# --- Invoices --------------------------------------------------------------
INVOICE_NUMBER_PREFIX=RE
INVOICE_DEFAULT_TAX_RATE=19
# Small-business rule under §19 UStG (true => 0% VAT + a note on the invoice)
INVOICE_SMALL_BUSINESS=false
INVOICE_DEFAULT_HOURLY_RATE_CENTS=12000
INVOICE_PAYMENT_TERM_DAYS=14

# Sender details for the invoice PDFs
COMPANY_NAME=Philipp Niestroj
COMPANY_STREET=Musterstraße 1
COMPANY_ZIP=12345
COMPANY_CITY=Musterstadt
COMPANY_COUNTRY=Deutschland
COMPANY_EMAIL=contact@philippniestroj.com
COMPANY_PHONE=
COMPANY_VAT_ID=
COMPANY_TAX_NUMBER=
COMPANY_IBAN=
COMPANY_BIC=
COMPANY_BANK=
