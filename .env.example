# ---------------------------------------------------------------------------
# soloops — kopiere nach .env und fülle aus
# ---------------------------------------------------------------------------

# --- Basis -----------------------------------------------------------------
NODE_ENV=development
TZ=Europe/Berlin
APP_URL=http://localhost:5174
# Host-Port des Frontends in der Entwicklung (Container bleibt intern auf 5173)
WEB_PORT=5174
# Host-Port der API in der Entwicklung (Container bleibt intern auf 3000)
API_PORT=3000
# Host-Port im Produktivbetrieb (docker-compose.prod.yml). Nicht 3000 wählen —
# das belegt auf dem Server schon das Portfolio.
SOLOOPS_PORT=8090

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=soloops
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=soloops
DATABASE_URL=postgresql://soloops:change-me-postgres@postgres:5432/soloops?schema=public

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Auth ------------------------------------------------------------------
# openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret-min-32-chars-long-please
# Statischer Bearer-Token für Worker + MCP-Server (maschinelle Clients)
SERVICE_TOKEN=change-me-service-token

# Erstuser, wird beim ersten Seed angelegt
OWNER_EMAIL=contact@philippniestroj.com
OWNER_NAME=Philipp Niestroj
OWNER_PASSWORD=change-me-login-password

# --- Anthropic (Projekt-Digests, Meeting-Summaries, Action Items) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- UptimeRobot -----------------------------------------------------------
# https://uptimerobot.com/dashboard -> Integrations & API -> Main API Key
UPTIMEROBOT_API_KEY=
UPTIME_POLL_CRON=*/5 * * * *

# --- CI/CD -----------------------------------------------------------------
# GitHub PAT mit repo + workflow (read)
GITHUB_TOKEN=
# GitLab PAT mit read_api
GITLAB_TOKEN=
GITLAB_HOST=https://gitlab.com
PIPELINE_POLL_CRON=*/3 * * * *

# --- lexoffice -------------------------------------------------------------
# https://app.lexoffice.de/addons/public-api
LEXOFFICE_API_KEY=
LEXOFFICE_BASE_URL=https://api.lexoffice.io

# --- Kalender-Sync ---------------------------------------------------------
# Google Cloud Console -> Calendar API aktivieren -> Anmeldedaten ->
# OAuth-Client-ID (Webanwendung) mit exakt dieser Redirect-URI:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar-accounts/google/callback
# Apple: App-spezifisches Passwort auf appleid.apple.com erzeugen
CALDAV_APPLE_URL=https://caldav.icloud.com
CALENDAR_SYNC_CRON=*/10 * * * *

# --- Postfach (nur lesend) -------------------------------------------------
# Zugangsdaten pro Konto in der Oberflaeche unter Einstellungen, nicht hier.
MAIL_POLL_CRON=*/10 * * * *
MAIL_BACKFILL_DAYS=90
# Harte Untergrenze: aelter wird nie abgerufen, egal was oben steht.
MAIL_SYNC_FROM=2026-09-01
MAIL_MAX_PER_RUN=200

# --- Videokonferenz --------------------------------------------------------
# JITSI (kein Konto nötig) | GOOGLE_MEET (braucht Google-Konto) | CUSTOM
VIDEO_PROVIDER=JITSI
JITSI_BASE_URL=https://meet.jit.si
# Eigener Dauerraum (Zoom/Teams), nur für VIDEO_PROVIDER=CUSTOM
VIDEO_CUSTOM_URL=


# --- Rechnungen ------------------------------------------------------------
INVOICE_NUMBER_PREFIX=RE
INVOICE_DEFAULT_TAX_RATE=19
# Kleinunternehmerregelung §19 UStG (true => 0% USt + Hinweis auf der Rechnung)
INVOICE_SMALL_BUSINESS=false
INVOICE_DEFAULT_HOURLY_RATE_CENTS=12000
INVOICE_PAYMENT_TERM_DAYS=14

# Absenderdaten für die Rechnungs-PDFs
COMPANY_NAME=Philipp Niestroj
COMPANY_STREET=Musterstraße 1
COMPANY_ZIP=12345
COMPANY_CITY=Musterstadt
COMPANY_COUNTRY=Deutschland
COMPANY_EMAIL=contact@philippniestroj.com
COMPANY_PHONE=
COMPANY_VAT_ID=
COMPANY_TAX_NUMBER=
COMPANY_IBAN=
COMPANY_BIC=
COMPANY_BANK=
