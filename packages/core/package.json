{
  "name": "@soloops/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx test/recurrence.test.ts && tsx test/sales.test.ts && tsx test/activity.test.ts && tsx test/sync.test.ts && tsx test/automations.test.ts && tsx test/tasks.test.ts && tsx test/taskLinkState.test.ts && tsx test/timeNarrative.test.ts && tsx test/repoCommitRead.test.ts && tsx test/contracts.test.ts && tsx test/contacts.test.ts && tsx test/invoices.test.ts && tsx test/schemaParity.test.ts",
    "test:sync": "tsx test/sync.integration.ts",
    "test:invoices": "tsx test/invoices.integration.ts",
    "sync:registry": "tsx scripts/exportSyncRegistry.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@prisma/client": "^6.3.0",
    "@soloops/shared": "*",
    "bullmq": "^6.3.1",
    "imapflow": "^2.1.0",
    "ioredis": "^6.0.0",
    "mailparser": "^3.9.29",
    "pdfkit": "^0.16.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.7",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
